{
  "version": 2,
  "name": "eco-village-map",
  "builds": [
    {
      "src": "server-complete.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/**",
          "data/**"
        ],
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/api/images/(.*)",
      "dest": "/server-complete.js",
      "methods": [
        "GET"
      ],
      "headers": {
        "Cache-Control": "public, max-age=300, s-maxage=300, stale-while-revalidate=3600"
      }
    },
    {
      "src": "/images/(.*)",
      "status": 302,
      "headers": {
        "Location": "https://raw.githubusercontent.com/SacredRebel/EcoVillage-map/main/images/$1",
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/server-complete.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "ignoreCommand": "bash scripts/vercel-ignore.sh"
}
