{
  "version": 2,
  "name": "ecovillage-builder",
  "builds": [
    {
      "src": "server-complete.js",
      "use": "@vercel/node"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/api/images/(.*)",
      "dest": "/server-complete.js",
      "methods": ["GET"],
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/server-complete.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
